# Not sure what a .gitignore is?
# See: https://git-scm.com/docs/gitignore

# These are directly copied from Jekyll's first-party docs on `.gitignore` files:
# https://jekyllrb.com/tutorials/using-jekyll-with-bundler/#commit-to-source-control

# Ignore the default location of the built site, and caches and metadata generated by Jekyll
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata
.DS_Store

# Ignore folders generated by Bundler.
# NOTE: the leading slash matters. An unanchored `vendor/` also matches
# assets/js/vendor/, which holds the site's own vendored webaudio-controls.js —
# without it that file is silently never committed and 404s in production.
.bundle/
/vendor/

# THIS REPOSITORY IS PUBLIC. Committing a file here publishes it, whether or
# not Jekyll builds it into the site — so internal engineering notes must stay
# out of git entirely, not merely out of _config.yml's `exclude:` list.
# They belong in the team's private engineering repository instead. The paths
# stay listed here so re-creating one can never be committed by accident.
tbd-16/learn/WASM-PLAYHEAD-HANDOVER.md
assets/runtime/groovebox-dev/README.md
assets/runtime/tbd-wasm-sdk/README.md
